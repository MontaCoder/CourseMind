# Server Configuration
PORT=5000
MONGODB_URI=mongodb://localhost:27017/coursemind
WEBSITE_URL=http://localhost:8080

# Security (REQUIRED - generate a strong random string)
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5000

# Browser-exposed client configuration
# Leave VITE_API_URL empty for same-origin API calls in the unified production server.
VITE_API_URL=
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_WEBSITE_URL=http://localhost:8080
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id
VITE_FACEBOOK_CLIENT_ID=your-facebook-app-id

# Branding
LOGO=https://your-logo-url.com/logo.png
COMPANY=Your Company Name

# API Keys
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openrouter/free
PEXELS_API_KEY=your-pexels-api-key
DEFAULT_COURSE_IMAGE_URL=https://your-fallback-course-image-url.com/image.jpg

# Social Auth Verification
GOOGLE_CLIENT_ID=your-google-oauth-client-id
FACEBOOK_CLIENT_ID=your-facebook-app-id

# Production-only first-user admin bootstrap
ADMIN_BOOTSTRAP_TOKEN=change-this-random-token

# Email Configuration (Required for user registration/password reset)
EMAIL=your-email@gmail.com
PASSWORD=your-app-password

# Payment Gateway Keys (Choose one or more)
# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_APP_SECRET_KEY=your-paypal-secret-key
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id

# Razorpay (India)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-flutterwave-secret-key

# Subscription Plans
MONTH_TYPE='Monthly Plan'
MONTH_COST=5
YEAR_TYPE='Yearly Plan'
YEAR_COST=49
