# Server Configuration
PORT=3000
MONGODB_URI=mongodb://localhost:27017/coursemind
WEBSITE_URL=http://localhost:3000

# Security (REQUIRED - generate a strong random string)
JWT_SECRET=your-256-bit-secret-key-change-this-in-production
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# Branding
LOGO=https://your-logo-url.com/logo.png
COMPANY=Your Company Name

# API Keys
API_KEY=your-openai-or-gemini-api-key

# Email Configuration (Required for user registration/password reset)
EMAIL=your-email@gmail.com
PASSWORD=your-app-password

# Unsplash (Optional - for stock photos)
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# Payment Gateway Keys (Choose one or more)
# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_APP_SECRET_KEY=your-paypal-secret-key

# Razorpay (India)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret

# Stripe
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key

# Paystack
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# Flutterwave
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-flutterwave-public-key
FLUTTERWAVE_SECRET_KEY=FLWSECK-your-flutterwave-secret-key

# Subscription Plans
MONTH_TYPE='Monthly Plan'
MONTH_COST=5
YEAR_TYPE='Yearly Plan'
YEAR_COST=49